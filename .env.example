# ==============================================================================
# Trenno Environment Configuration (Template)
# Copy this file to .env and adjust credentials as appropriate.
# All container and orchestration variables are defined strictly in this file.
# ==============================================================================

# Project & Network Configuration
COMPOSE_PROJECT_NAME=trenno
NETWORK_NAME=trenno-network

# Physical Host Volumes on this VM
DATA_PATH=/home/transcendence/data
DB_DATA_DIR=/home/transcendence/data/db
UPLOADS_DATA_DIR=/home/transcendence/data/uploads
CERTS_DATA_DIR=/home/transcendence/data/certs
PROMETHEUS_DATA_DIR=/home/transcendence/data/prometheus
GRAFANA_DATA_DIR=/home/transcendence/data/grafana

# Container Names
CONTAINER_NAME_DB=trenno-db
CONTAINER_NAME_BACKEND=trenno-backend
CONTAINER_NAME_FRONTEND=trenno-frontend
CONTAINER_NAME_NGINX=trenno-nginx
CONTAINER_NAME_PROMETHEUS=trenno-prometheus
CONTAINER_NAME_GRAFANA=trenno-grafana
CONTAINER_NAME_NODE_EXPORTER=trenno-node-exporter
CONTAINER_NAME_POSTGRES_EXPORTER=trenno-postgres-exporter

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=trenno
POSTGRES_USER=trenno
POSTGRES_PASSWORD=P@ssw0rd
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Backend Service Configuration (Node.js / Express API & WebSockets)
NODE_ENV=production
BACKEND_HOST=backend
BACKEND_PORT=3000
APP_URL=https://localhost:8443
DATABASE_URL=postgresql://trenno:P@ssw0rd@db:5432/trenno
SESSION_SECRET=a8f82d1c6e94b238f902c5e6381048b7123456789abcdef0123456789abcdef0
TOTP_ENCRYPTION_KEY=dHJlbm5vLXRvdHAtZW5jcnlwdGlvbi1rZXktMjAyNiE=
SEED_SA_EMAIL=admin@trenno.local
SEED_SA_PASSWORD=P@ssw0rd

# Frontend Service Configuration (React SPA)
FRONTEND_HOST=frontend
FRONTEND_PORT=80

# Reverse Proxy Gateway Configuration (Nginx + TLS)
HTTPS_PORT=8443
NGINX_HTTPS_PORT=8443

# Prometheus Monitoring Configuration
PROMETHEUS_USER=admin
PROMETHEUS_PASSWORD=P@ssw0rd
PROMETHEUS_EXTERNAL_URL=https://localhost:8443/prometheus/

# Grafana Observability Dashboard Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=P@ssw0rd
GRAFANA_USERS_ALLOW_SIGN_UP=false
GRAFANA_AUTH_ANONYMOUS_ENABLED=false
GRAFANA_SECURITY_COOKIE_SECURE=true
GRAFANA_SERVER_ROOT_URL=https://localhost:8443/grafana/
GRAFANA_SERVER_SERVE_FROM_SUB_PATH=true

# Exporters Configuration
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://trenno:P@ssw0rd@db:5432/trenno?sslmode=disable
