# ==============================================================================
# Trenno Environment Configuration (Template)
# Copy this file to .env and adjust credentials as appropriate.
# All container and orchestration variables are defined strictly in this file.
# ==============================================================================

# Project & Network Configuration
COMPOSE_PROJECT_NAME=
NETWORK_NAME=

# Physical Host Volumes on this VM
DATA_PATH=
DB_DATA_DIR=
UPLOADS_DATA_DIR=
CERTS_DATA_DIR=
PROMETHEUS_DATA_DIR=
GRAFANA_DATA_DIR=

# Container Names
CONTAINER_NAME_DB=
CONTAINER_NAME_BACKEND=
CONTAINER_NAME_FRONTEND=
CONTAINER_NAME_NGINX=
CONTAINER_NAME_PROMETHEUS=
CONTAINER_NAME_GRAFANA=
CONTAINER_NAME_NODE_EXPORTER=
CONTAINER_NAME_POSTGRES_EXPORTER=

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_HOST_PORT=

# Backend Service Configuration (Node.js / Express API & WebSockets)
NODE_ENV=
BACKEND_HOST=
BACKEND_PORT=
APP_URL=
DATABASE_URL=
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
SEED_SA_EMAIL=
SEED_SA_PASSWORD=

# Frontend Service Configuration (React SPA)
FRONTEND_HOST=
FRONTEND_PORT=

# Reverse Proxy Gateway Configuration (Nginx + TLS)
HTTPS_PORT=
NGINX_HTTPS_PORT=

# Prometheus Monitoring Configuration
PROMETHEUS_USER=
PROMETHEUS_PASSWORD=
PROMETHEUS_EXTERNAL_URL=

# Grafana Observability Dashboard Configuration
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_USERS_ALLOW_SIGN_UP=
GRAFANA_AUTH_ANONYMOUS_ENABLED=
GRAFANA_SECURITY_COOKIE_SECURE=
GRAFANA_SERVER_ROOT_URL=
GRAFANA_SERVER_SERVE_FROM_SUB_PATH=

# Exporters Configuration
POSTGRES_EXPORTER_DATA_SOURCE_NAME=

# Backups & Disaster Recovery (docs/disaster-recovery.md)
CONTAINER_NAME_BACKUP=
BACKUP_DIR=
BACKUP_SCHEDULE=
BACKUP_KEEP=
BACKUP_MAX_AGE_HOURS=
BACKUP_TZ=
BACKUP_UID=

# Gmail SMTP with App Password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
