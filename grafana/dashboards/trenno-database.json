      "id": 300,
      "title": "PostgreSQL Key Performance Indicators",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 80 }] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 31,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "title": "Active DB Connections",
      "type": "stat",
      "targets": [{ "expr": "sum(pg_stat_activity_count) or vector(0)", "instant": false, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 98 }] },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 32,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "title": "Buffer Cache Hit Ratio",
      "type": "stat",
      "targets": [{ "expr": "(sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])) + 0.001)) * 100", "instant": false, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "cps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 33,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "title": "Transactions Committed / sec",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_commit[1m])) or vector(0)", "instant": false, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 34,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "title": "Trenno DB Size",
      "type": "stat",
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"trenno\"} or vector(0)", "instant": true, "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 301,
      "title": "Transactions & Cache Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 },
          "unit": "cps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 35,
      "title": "Commits vs Rollbacks per Second",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit[1m]))", "legendFormat": "Commits", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback[1m]))", "legendFormat": "Rollbacks", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 36,
      "title": "Row Level Operations (Fetched / Inserted / Updated / Deleted)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_fetched[1m]))", "legendFormat": "Fetched", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_tup_inserted[1m]))", "legendFormat": "Inserted", "refId": "B" },
        { "expr": "sum(rate(pg_stat_database_tup_updated[1m]))", "legendFormat": "Updated", "refId": "C" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted[1m]))", "legendFormat": "Deleted", "refId": "D" }
      ]
    }
  ],
